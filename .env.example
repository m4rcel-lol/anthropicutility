# Required: Discord bot token from https://discord.com/developers/applications
# Leave empty here — set it in your local .env only (never commit the real token).
DISCORD_BOT_TOKEN=

# Required: global RSS/Atom feed (same for every server).
NEWS_SOURCE_URL=https://rsshub.bestblogs.dev/anthropic/news

# Optional: minutes between polls (default 15)
POLL_INTERVAL_MINUTES=15

# Optional: max characters of post body shown in the embed (default 280)
EXCERPT_LENGTH=280

# Optional: path to the SQLite database inside the container (default /data/bot.db)
SQLITE_PATH=/data/bot.db
